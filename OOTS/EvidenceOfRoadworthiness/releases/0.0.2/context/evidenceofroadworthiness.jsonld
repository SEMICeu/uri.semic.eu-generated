{
  "@context": {
    "Attribute": "http://data.europa.eu/p4s/Attribute",
    "AttributeSet": "http://data.europa.eu/p4s/AttributeSet",
    "Check": "https://spec.edmcouncil.org/auto/ontology/VC/VehicleCore/Check",
    "Code": "http://www.w3.org/2004/02/skos/core#Concept",
    "DateTime": "http://www.w3.org/2001/XMLSchema#dateTime",
    "Decimal": "https://www.w3.org/TR/xmlschema11-2/#decimal",
    "Evidence": "http://data.europa.eu/m8g/Evidence",
    "EvidenceOfRoadworthiness": "http://data.europa.eu/p4s/EvidenceOfRoadworthiness",
    "LegalEntity": "http://www.w3.org/ns/legal#LegalEntity",
    "OOTSEvidence": "http://data.europa.eu/p4s/OOTSEvidence",
    "RoadVehicle": "https://spec.edmcouncil.org/auto/ontology/VC/VehicleCore/RoadVehicle",
    "String": "http://www.w3.org/2001/XMLSchema#string",
    "Text": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString",
    "dateOfExpiryRoadworthinessTest": {
      "@container": "@set",
      "@id": "https://spec.edmcouncil.org/auto/ontology/VC/VehicleCore/validThrough",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "dateOfRoadworthinessTest": {
      "@container": "@set",
      "@id": "https://spec.edmcouncil.org/auto/ontology/VC/VehicleCore/validFrom",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "hasAttribute": {
      "@container": "@set",
      "@id": "http://data.europa.eu/p4s/hasAttribute",
      "@type": "@id"
    },
    "hasAttributeSet": {
      "@id": "http://data.europa.eu/p4s/hasAttributeSet",
      "@type": "@id"
    },
    "isAbout": {
      "@id": "http://purl.org/dc/terms/subject",
      "@type": "@id"
    },
    "legalName": {
      "@container": "@set",
      "@id": "http://www.w3.org/ns/legal#legalName",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
    },
    "odometerReading": {
      "@container": "@set",
      "@id": "http://data.europa.eu/p4s/odometerReading",
      "@type": "http://www.w3.org/2001/XMLSchema#decimal"
    },
    "placeOfRoadworthinessTest": {
      "@container": "@set",
      "@id": "http://data.europa.eu/p4s/PlaceRoadworthinessTest",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
    },
    "publisher": {
      "@container": "@set",
      "@id": "http://purl.org/dc/terms/publisher",
      "@type": "@id"
    },
    "registrationPlateNumber": {
      "@container": "@set",
      "@id": "http://data.europa.eu/p4s/registrationPlateNumber",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    },
    "requires": {
      "@id": "http://purl.org/dc/terms/requires",
      "@type": "@id"
    },
    "vehicleCategory": {
      "@container": "@set",
      "@id": "http://data.europa.eu/p4s/vehicleCategory",
      "@type": "@id"
    },
    "vehicleIdentificationNumber": {
      "@container": "@set",
      "@id": "https://spec.edmcouncil.org/auto/ontology/VC/VehicleCore/vehicleIdentificationNumber",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    }
  }
}
