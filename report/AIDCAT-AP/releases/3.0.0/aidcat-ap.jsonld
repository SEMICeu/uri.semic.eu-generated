{
"@id": "http://data.europa.eu/it6/AISystem",
"@type": "http://www.w3.org/2002/07/owl#Class",
"ap-definition-en" : {"en": "A machine-based system that is designed to operate with varying levels of autonomy and that may exhibit adaptiveness after deployment, and that, for explicit or implicit objectives, infers, from the input it receives, how to generate outputs such as predictions, content, recommendations, or decisions that can influence physical or virtual environments."}, "ap-usageNote-en" : {"en": "The provider of an AI system and the provider of the machine learning model it uses can be different organisations."}, "usage" : {"en": "The provider of an AI system and the provider of the machine learning model it uses can be different organisations."}, "ap-label-en" : {"en": "AI System"}, "definition" : {"en": "A machine-based system that is designed to operate with varying levels of autonomy and that may exhibit adaptiveness after deployment, and that, for explicit or implicit objectives, infers, from the input it receives, how to generate outputs such as predictions, content, recommendations, or decisions that can influence physical or virtual environments."}, "label" : {"en": "AI System"},
