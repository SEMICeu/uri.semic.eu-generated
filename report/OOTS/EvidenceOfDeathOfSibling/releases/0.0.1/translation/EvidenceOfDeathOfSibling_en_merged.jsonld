    {
      "@id": "http://www.w3.org/ns/person#countryOfDeath",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "EA-Guid": "{C58092CC-C21A-4932-A0EA-65E8519BA158}",
      "ap-definition-en": {
        "en": "The country in which the Person died."
      },
      "ap-label-en": {
        "en": "country of death"
      },
      "codelist": [],
      "definition": {
        "en": "The country in which the Person died."
