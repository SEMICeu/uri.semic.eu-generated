          },
          {
            "key": "usageNote-en",
            "note": "This class has been added in the CPSV-AP to complement the need for adding other ways of classifying the Public Service, which have not been explicitly defined in the CPSV-AP. In this context, the CPSV-AP reuses the Concept class as defined in <a href=\"https://www.w3.org/2004/02/skos/\">the SKOS Simple Knowledge Organization System</a>. For describing the attributes of a Concept (labels, preferred labels, alternative labels, definition, etc.) we refer to <a href=\"https://www.w3.org/2004/02/skos/\">SKOS</a>. The Concept may or may not belong to (member) a certain Collection.",
            "value": "NOTE"
          }
        ],
