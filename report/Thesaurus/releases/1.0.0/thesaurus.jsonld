"inpackage": "OTHER_PACKAGE",
"ap-definition-en" : {"en": "This class represent the way Concepts belong together. Thus, different concepts are grouped and define a controlled vocabulary."}, "usage" : {"en": "In this context, the CPSV-AP reuses the Collection class as defined in <a href=\"https:\/\/www.w3.org\/2004\/02\/skos\/\">the SKOS Simple Knowledge Organization System<\/a>. For describing the attributes of a Collection (labels, preferred labels, alternative labels, definition, etc.) we refer to <a href=\"https:\/\/www.w3.org\/2004\/02\/skos\/\">SKOS<\/a>."}, "ap-label-en" : {"en": "Collection"}, "definition" : {"en": "This class represent the way Concepts belong together. Thus, different concepts are grouped and define a controlled vocabulary."}, "label" : {"en": "Collection"},
